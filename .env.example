# Copy to .env and fill in your key. Every RAG_* line is optional (defaults shown).
OPENAI_API_KEY=sk-...

# Folders
RAG_DOCS_DIR=docs
RAG_DATA_DIR=data

# Step 1 - file checks
RAG_MAX_FILE_MB=100

# Step 2 - OCR (needs tesseract: brew install tesseract)
RAG_OCR_ENABLED=true
RAG_OCR_LANG=eng
RAG_OCR_DPI=300
RAG_OCR_MIN_CONF=40

# Step 3 - cleaning
RAG_MIN_DOC_CHARS=50

# Step 4 - chunking: structure | recursive | sentence | fixed
RAG_CHUNK_STRATEGY=structure
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=75
RAG_MIN_CHUNK_TOKENS=20

# Step 6 - embeddings
RAG_EMBED_MODEL=text-embedding-3-small
RAG_EMBED_DIMS=1536
RAG_EMBED_BATCH=100
RAG_MAX_RETRIES=5

# Step 7 - ChromaDB
RAG_COLLECTION=documents

# Retrieval (ask.py)
RAG_TOP_K=3                 # sources sent to the LLM
RAG_CANDIDATES=20           # results taken from each search before merging
RAG_RRF_K=60                # reciprocal rank fusion constant
RAG_MIN_SIMILARITY=0.30     # cosine similarity a chunk needs to count as relevant
RAG_MIN_KEYWORD_SCORE=4.0   # ...or this BM25 keyword score (exact terms, numbers, names)
RAG_MIN_RELATIVE_SCORE=0.6  # also drop sources below 0.6 x the best similarity (0 = off)

# Generation (ask.py)
RAG_LLM_MODEL=gpt-4o-mini
RAG_LLM_TEMPERATURE=0       # leave empty for models that don't accept a temperature
RAG_LLM_MAX_TOKENS=600

# Web app sign-in (serve.py) - GitHub OAuth. See "Set up GitHub sign-in" in the README.
RAG_AUTH=github                 # github | off (off = no sign-in; only for use on this computer)
RAG_GITHUB_CLIENT_ID=
RAG_GITHUB_CLIENT_SECRET=
RAG_SESSION_SECRET=             # 32+ random characters - see README for a command to make one
RAG_PUBLIC_URL=http://127.0.0.1:8000
RAG_SESSION_HOURS=8
# Roles by GitHub username, comma separated (viewer < editor < admin)
RAG_ADMINS=
RAG_EDITORS=
RAG_VIEWERS=
RAG_DEFAULT_ROLE=none           # none = refuse anyone not listed | viewer = any GitHub user may ask

